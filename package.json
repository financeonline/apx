{
  "name": "motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/ocr-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ocr-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project demo-apx \"vitest run --project integration\"",
    "test:integration:watch": "vitest --project integration",
    "ai:eval": "vitest run --project eval",
    "ai:eval:live": "tsx scripts/ai-eval-live.ts",
    "db:indexes": "tsx scripts/firestore-indexes.ts",
    "db:start": "node -e \"require('fs').mkdirSync('firebase/emulator-data',{recursive:true})\" && firebase emulators:start --only auth,firestore,storage --project demo-apx --import firebase/emulator-data --export-on-exit firebase/emulator-data",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test journey-1 journey-8",
    "e2e:ui": "playwright test --ui",
    "engine:upgrade": "tsx scripts/engine-upgrade.ts",
    "engine:compare": "vitest run --project regression"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "canonicalize": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "docx": "9.8.1",
    "exceljs": "^4.4.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.2.3",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "firebase-tools": "^15.34.1",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
