rules_version = '2';

// APX never lets a browser read or write Firestore directly (FIRESTORE_DATA_MODEL.md §2).
// Every read and write is made by the APX server with the Admin SDK, which checks the caller's
// organisation and permissions first — the role the database's row-level security played on
// PostgreSQL. A client SDK request is therefore always refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
