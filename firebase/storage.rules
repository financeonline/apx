rules_version = '2';

// Files (source documents, reports) are written and served only by the APX server, which checks
// the caller and audits every download first (core/storage/signer.ts). No browser access.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
