# Public — safe in the browser. The anon key is safe ONLY because RLS is forced on every table
# and `authenticated` holds no write privilege (ADR-026).
# MOTION's local stack is remapped to 544xx because 54321/54322 belong to another local project.
# `supabase status` prints the live values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefixed NEXT_PUBLIC_. See SECURITY_MODEL.md §5.
# Imported by exactly three files: core/db/service-client.ts, core/db/server-rpc.ts, core/storage/signer.ts
SUPABASE_SERVICE_ROLE_KEY=

# Integration tests only: mints a Supabase-shaped JWT per role so RLS is exercised for real
# rather than bypassed with the service key (TEST_STRATEGY.md §1). `supabase status` prints it.
SUPABASE_JWT_SECRET=

# Cron shared secret for /api/jobs/run (constant-time compared).
CRON_SECRET=

# Phase 5+. Absent in Phase 1.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # optional; the AI Analyst model (default Haiku 4.5)
