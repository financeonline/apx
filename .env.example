# Local development runs on the Firebase emulators (`npm run db:start`); `bash scripts/write-local-env.sh`
# writes the emulator values below into .env.local. A `demo-` project can never reach Google's servers.
# FIRESTORE_DATA_MODEL.md §1.

# Public — safe in the browser. The browser only signs in with Firebase Authentication; it never reads
# Firestore or Storage (the security rules refuse every client request, SECURITY_MODEL.md §5).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-apx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-apx
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server only. Never prefixed NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=demo-apx
FIREBASE_STORAGE_BUCKET=demo-apx.appspot.com
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# A real Firebase project instead of the emulators: unset the *_EMULATOR_HOST lines, set the project
# id, bucket and NEXT_PUBLIC_FIREBASE_* web config, and give the server its service account (read only
# by src/db/firestore.ts) and the 32-byte key the platform secrets are sealed with (base64).
# FIREBASE_SERVICE_ACCOUNT=
# APX_SECRETS_KEY=

# Cron shared secret for /api/jobs/run (constant-time compared).
CRON_SECRET=

# Optional: a server-side Anthropic key and model.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # optional; the AI Analyst model (default Haiku 4.5)
